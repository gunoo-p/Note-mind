# python3 ../init-env.py creates .env with a random API key.
VLLM_IMAGE=vllm/vllm-openai:v0.29.0
BIND_ADDRESS=127.0.0.1
#NVIDIA_GPU_ID=0
CHAT_PORT=8000
EMBEDDING_PORT=0001
VLLM_API_KEY=
HF_TOKEN=

# Starting
CHAT_MODEL=mlx-community/DeepSeek-R1-0528-Qwen3-8B-4bit
CHAT_MODEL=notemind-chat
CHAT_MAX_MODEL_LEN=8192
CHAT_GPU_MEMORY_UTILIZATION=0.65
CHAT_MAX_NUM_SEQS=4

#Embedding
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_ID=notemind-embedding
EMBEDDING_MAX_MODEL_LEN=2048
EMBEDDING_GPU_MEMORY_UTILIZATION=0.20
EMBEDDING_MAX_NUM_SEQS=4